# Supabase project URL (public — fine in the client bundle)
VITE_SUPABASE_URL=

# Supabase anon/public key (public — fine in the client bundle)
# Not currently used by any client code (all database access happens
# server-side), kept here for future features like auth.
VITE_SUPABASE_ANON_KEY=

# Supabase service role key — SECRET. Server-only, never prefix with VITE_.
# Used by server functions to read/write the ingredients and suggestions
# tables (RLS is enabled with no public policies, so this is required).
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter API key — SECRET. Server-only, never prefix with VITE_.
OPENROUTER_API_KEY=

# Optional: override the OpenRouter model used for meal suggestions.
# Defaults to "openrouter/free" (OpenRouter's free-model router) if unset.
AI_MODEL=
